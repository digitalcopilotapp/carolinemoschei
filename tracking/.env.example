# =============================================================================
# Digital Copilot Infrastructure — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Server ---
SERVER_IP=YOUR_KVM_IP_HERE
DOMAIN=digitalcopilot.app

# --- PostgreSQL ---
POSTGRES_USER=dcadmin
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_LISTMONK_DB=listmonk
POSTGRES_CHATWOOT_DB=chatwoot
POSTGRES_DCBRIDGE_DB=dcbridge
POSTGRES_LISTMONK_USER=listmonk_user
POSTGRES_LISTMONK_PASSWORD=CHANGE_ME
POSTGRES_CHATWOOT_USER=chatwoot_user
POSTGRES_CHATWOOT_PASSWORD=CHANGE_ME
POSTGRES_DCBRIDGE_USER=dcbridge_user
POSTGRES_DCBRIDGE_PASSWORD=CHANGE_ME

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME

# --- Stalwart Mail ---
STALWART_ADMIN_USER=admin
STALWART_ADMIN_PASSWORD=CHANGE_ME

# --- Listmonk ---
LISTMONK_ADMIN_USER=admin
LISTMONK_ADMIN_PASSWORD=CHANGE_ME
LISTMONK_SMTP_HOST=stalwart
LISTMONK_SMTP_PORT=587
LISTMONK_SMTP_USER=noreply@digitalcopilot.app
LISTMONK_SMTP_PASSWORD=CHANGE_ME

# --- SnappyMail ---
# Configured via admin panel after first boot

# --- Chatwoot ---
CHATWOOT_SECRET_KEY_BASE=GENERATE_WITH_openssl_rand_hex_64
CHATWOOT_FRONTEND_URL=https://crm.digitalcopilot.app
CHATWOOT_DEFAULT_LOCALE=pt_BR
CHATWOOT_MAILER_SENDER_EMAIL=contato@digitalcopilot.app

# --- dc-bridge ---
DCBRIDGE_PORT=3100
CHATWOOT_BASE_URL=http://chatwoot-web:3000
LISTMONK_API_URL=http://listmonk:9000
LISTMONK_API_USER=admin
LISTMONK_API_PASSWORD=CHANGE_ME

# Admin API for managing tenants (clients)
TENANT_ADMIN_SECRET=GENERATE_WITH_openssl_rand_hex_32

# Legacy/fallback (used when no tenant is configured in DB)
HOTMART_WEBHOOK_SECRET=YOUR_HOTMART_WEBHOOK_SECRET
META_PIXEL_ID=YOUR_META_PIXEL_ID
META_ACCESS_TOKEN=YOUR_META_CAPI_ACCESS_TOKEN
CHATWOOT_API_TOKEN=YOUR_CHATWOOT_API_TOKEN
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_WHATSAPP_INBOX_ID=1
LISTMONK_POSVENDA_LIST_ID=2

# --- Amazon SES (Email Fallback) ---
# Primary: Stalwart (self-hosted). Fallback: SES.
# SES SMTP credentials are NOT your AWS access keys.
# Generate them in AWS Console → SES → SMTP Settings → Create SMTP Credentials.
SES_SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USER=YOUR_SES_SMTP_USERNAME
SES_SMTP_PASS=YOUR_SES_SMTP_PASSWORD
SES_REGION=us-east-1

# Stalwart SMTP (for dc-bridge health check)
STALWART_SMTP_HOST=stalwart
STALWART_SMTP_PORT=587
STALWART_SMTP_USER=noreply@digitalcopilot.app
STALWART_SMTP_PASS=CHANGE_ME
