# ============================================
# HOTMART WEBHOOK CONFIG
# ============================================
# Token secreto configurado no painel da Hotmart (hottok)
HOTMART_HOTTOK=seu_hottok_aqui
# Porta do servidor
PORT=3000

# ============================================
# BREVO (ex-Sendinblue) CONFIG
# ============================================
# API Key do Brevo (Menu > SMTP & API > API Keys)
BREVO_API_KEY=xkeysib-sua-api-key-aqui

# IDs das listas no Brevo (criar antes no painel)
# Lista de compradores
BREVO_LIST_BUYERS=2
# Lista de leads que abandonaram checkout
BREVO_LIST_ABANDONED=3
# Lista de reembolsados
BREVO_LIST_REFUNDED=4
# Lista geral (todos os contatos)
BREVO_LIST_ALL=5

# ============================================
# META CONVERSIONS API CONFIG
# ============================================
# Pixel ID do Meta (Events Manager > Data Sources > Pixel ID)
META_PIXEL_ID=seu_pixel_id_aqui
# Access Token (Events Manager > Settings > Generate Access Token)
META_ACCESS_TOKEN=seu_access_token_aqui
# Test Event Code (apenas para testes, remover em produção)
# META_TEST_EVENT_CODE=TEST12345

# ============================================
# APP CONFIG
# ============================================
NODE_ENV=production
LOG_LEVEL=info
