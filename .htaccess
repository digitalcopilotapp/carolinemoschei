Options -Indexes

# ── Redirects 301 ────────────────────────────────────────────
<IfModule mod_rewrite.c>
RewriteEngine On

# Legacy page URLs → canonical hub
RewriteRule ^pages/guia-de-poses\.html$ /guia-de-poses [R=301,L]
RewriteRule ^guia-gestantes/?$ /guia-de-poses [R=301,L]
RewriteRule ^guia-de-fotografia-ensaio-pessoal-e-criativo/?$ /guia-de-poses [R=301,L]
RewriteRule ^combo-guias-2026/?$ /guia-de-poses [R=301,L]

# ── Internal rewrites (clean URLs → HTML files) ──────────────
RewriteRule ^curso-photoshop/?$ /pages/curso-photoshop.html [L]
RewriteRule ^curso-de-fotografia-de-celular/?$ /pages/curso-de-fotografia-de-celular.html [L]
RewriteRule ^guia-iluminacao/?$ /pages/guia-iluminacao.html [L]
RewriteRule ^guia-fotografia-corporativa/?$ /pages/guia-fotografia-corporativa.html [L]
RewriteRule ^guia-de-poses/?$ /pages/guia-de-poses/index.html [L]
RewriteRule ^funil/?$ /pages/funil/index.html [L]
RewriteRule ^links/?$ /pages/links.html [L]
RewriteRule ^presets/?$ /pages/presets.html [L]
RewriteRule ^orcamentos/?$ /pages/orcamentos.html [L]
RewriteRule ^verso-reverso/?$ /pages/verso-reverso.html [L]
RewriteRule ^wsp-2026/?$ /pages/wsp-2026.html [L]

# ── Static file passthrough ──────────────────────────────────
# Serve existing files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

</IfModule>

# ── Cache headers for static assets ──────────────────────────
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/webp "access plus 1 year"
ExpiresByType image/jpeg "access plus 1 year"
ExpiresByType image/png  "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 year"
ExpiresByType text/css  "access plus 1 month"
ExpiresByType application/javascript "access plus 1 month"
ExpiresByType font/ttf  "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ── Security headers ──────────────────────────────────────────
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set X-Frame-Options "SAMEORIGIN"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
